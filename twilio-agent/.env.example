# Twilio Dev Phone credentials — from the Twilio Console (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBERS=

# From the TAC Setup Wizard (npx twilio-agent-connect setup) or Console:
# Memory Store + Conversation Configuration SIDs
TWILIO_CONVERSATIONS_MEMORY_STORE_SID=
TWILIO_CONVERSATIONS_CONFIGURATION_SID=

# The deployed Phenox worker (Person B's Cloudflare Worker) — no key needed here,
# the worker itself holds the Gemini/Tiger Data secrets.
FIRELINE_WORKER_URL=https://fireline-verdict.fireline-team.workers.dev
